    "@vitejs/plugin-react": "^4.7.0",
    "deno-bin": "^2.2.7",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9",
    "workbox-precaching": "^7.4.1",
